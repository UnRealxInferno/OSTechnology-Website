<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Custom error pages -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Static content / MIME types -->
    <staticContent>
      <!-- Serve HTML with explicit UTF-8 charset so browsers never guess Latin-1 -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html; charset=utf-8" />
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript; charset=utf-8" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- Markdown representation of each page, served to agents via the
           content-negotiation rules below or by requesting the .md URL. -->
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />

      <!-- Cache-Control default (1 hour) - covers HTML, script.js, css/*.
           Images/media get a long-lived override below since they change rarely. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>

    <!-- Compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <httpCompression>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="application/xml" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="font/woff2" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- HSTS: enforce HTTPS for 1 year, include subdomains, preload-ready -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        <!-- COOP: prevent cross-origin window references -->
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <!-- COEP: credentialless allows third-party embeds without CORS headers -->
        <add name="Cross-Origin-Embedder-Policy" value="credentialless" />
        <!-- CSP: allow only known trusted sources -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com https://connect.facebook.net https://web3forms.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.hcaptcha.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://ostechnology.uk; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;" />
      </customHeaders>
    </httpProtocol>

    <!-- URL Rewrite rules -->
    <rewrite>
      <rules>
        <!-- Redirect HTTP to HTTPS -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Redirect www to the canonical apex domain -->
        <rule name="WWW to non-WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.ostechnology\.uk$" />
          </conditions>
          <action type="Redirect" url="https://ostechnology.uk/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Redirect index.html to the site root -->
        <rule name="Redirect index.html to root" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- Microsoft 365 & AI for Business merged into Microsoft Modern Workplace -->
        <rule name="Redirect microsoft-365 to modern-workplace" stopProcessing="true">
          <match url="^services/business/microsoft-365(\.html)?$" />
          <action type="Redirect" url="/services/business/modern-workplace" redirectType="Permanent" />
        </rule>
        <rule name="Redirect ai to modern-workplace" stopProcessing="true">
          <match url="^services/business/ai(\.html)?$" />
          <action type="Redirect" url="/services/business/modern-workplace" redirectType="Permanent" />
        </rule>

        <!-- Redirect other .html requests to their clean, extensionless canonical URL -->
        <rule name="Redirect .html to extensionless" stopProcessing="true">
          <match url="^(.*)\.html$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Content negotiation: agents that ask for markdown get the .md
             representation of the page at the same URL. Browsers send
             "text/html,..." and never match, so HTML stays the default.
             These must run before the clean-URL rewrite below, which would
             otherwise send every extensionless request to the .html file. -->
        <rule name="Markdown negotiation for home page" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern="(text|application)/(x-)?markdown" />
            <add input="{DOCUMENT_ROOT}/index.md" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="index.md" />
        </rule>

        <rule name="Markdown negotiation" stopProcessing="true">
          <match url="^([^.]+)$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern="(text|application)/(x-)?markdown" />
            <add input="{DOCUMENT_ROOT}/{R:1}.md" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.md" />
        </rule>

        <!-- Clean URLs: rewrite /page to /page.html internally (no redirect, URL stays clean) -->
        <rule name="Clean URL rewrite" stopProcessing="true">
          <match url="^([^.]+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>

        <!-- Remove trailing slash from non-root URLs -->
        <rule name="Remove trailing slash" stopProcessing="true">
          <match url="(.+)/$" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="{R:1}" redirectType="Permanent" />
        </rule>
      </rules>

      <!-- The same URL now answers with HTML or markdown depending on Accept,
           so caches must key on it. Scoped to page responses: images and fonts
           keep their long-lived, Accept-independent caching. -->
      <outboundRules>
        <preConditions>
          <preCondition name="IsPageResponse">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/(html|markdown)" />
          </preCondition>
        </preConditions>
        <rule name="Vary on Accept" preCondition="IsPageResponse" stopProcessing="true">
          <match serverVariable="RESPONSE_Vary" pattern="^$" />
          <action type="Rewrite" value="Accept" />
        </rule>
        <!-- Compression sets "Vary: Accept-Encoding"; append rather than replace it. -->
        <rule name="Vary on Accept (append)" preCondition="IsPageResponse" stopProcessing="true">
          <match serverVariable="RESPONSE_Vary" pattern="^(?!.*Accept(?![-\w])).+$" />
          <action type="Rewrite" value="{R:0}, Accept" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Registering the .md MIME type above makes every .md file in the deployed
         tree fetchable, including ones that are not site content. Keep the
         local editor config directory out of that. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".claude" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- Long-lived cache override for assets that rarely change and are safe to cache
       aggressively (photos, logos, favicons). HTML/CSS/JS stay on the short default above. -->
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="media">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
